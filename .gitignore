.venv/
.pytest_cache/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
data/
private/
*.db
*.db-shm
*.db-wal
*.apk
*.xapk
*.ipa
*.pem
*.key
.env*

# Pinned public Mozilla roots; private certificate files stay ignored.
!macos-server/certificates/cacert.pem

# Audited source-only Love routing reference and metadata; no ADV/media/account data.
!/data/
/data/*
!/data/love-reference.json
!/data/love-adv-proof.json
!/data/love-reference-NOTICE.txt
!/data/love-server-overlay.zip
!/data/love-server-data-pin.json

# Frozen latest public payload metadata and its canonical LFS pointer only.
!/data/latest-server-data-pin.json
!/data/latest-server-overlay.zip
!/data/latest-korean-translations-pin.json
# Bounded Korean-only compiled packs and their semantic/readback pin.
!/data/korean-master-data-pin.json
!/data/korean-master-overlay.zip
# Original compiler source retained solely to verify the immutable old overlay.
!/data/legacy-sources/
/data/legacy-sources/*
!/data/legacy-sources/love_catalog.py
