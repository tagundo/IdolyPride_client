int main(int argc,char**argv){assert(argc==2);model.mode=atoi(argv[1]);int mode=model.mode;Mp4TimelineContext c;mp4_root_history::Path path{};mp4actor::Handle target{6,2,0};if(mode==1)model.current=false;if(mode==2)target={10,2,0};if(mode==11)target=c.root;if(mode==12)target={8,2,0};if(mode==13)target={6,3,0};bool good=mode==0||mode==4||mode==11;assert(mp4_root_history_path(c,target,&path)==good);if(good){assert(path.present);assert(path.length==(mode==11?0:2));}if(mode==1||mode==2||mode==13)assert(model.calls==0);}
