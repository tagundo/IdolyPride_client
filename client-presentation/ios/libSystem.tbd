--- !tapi-tbd-v3
archs: [ arm64 ]
platform: ios
install-name: /usr/lib/libSystem.B.dylib
current-version: 1
compatibility-version: 1
exports:
  - archs: [ arm64 ]
    symbols: [ _memcpy, _memmove, _memcmp, _memset, _bzero, _malloc, _free, _pread, _pwrite, _ftruncate, _dlsym, _strcmp, _strncmp, _strlen, _strstr,
      _snprintf, _strtod, _atan, _tan, _round, _lround, _llround,
      _pthread_mutex_lock, _pthread_mutex_unlock, _pthread_self, _pthread_create, _pthread_detach,
      _nanosleep, _clock_gettime, _socket, _setsockopt, _connect, _send, _recv, _close,
      _mach_task_self_, _mach_vm_region, _mach_port_deallocate,
      _open, _openat, _read, _write, _renameat, _unlinkat, _linkat, _flock, ___error, _fsync, _arc4random_buf, _fstat, _dup, _geteuid,
      __dyld_image_count, __dyld_get_image_name, __dyld_get_image_header, __dyld_get_image_vmaddr_slide,
      __tlv_bootstrap, __Unwind_Resume, dyld_stub_binder ]
...
